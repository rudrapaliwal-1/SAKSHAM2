# ═══════════════════════════════════════════════════════════════════════════════
# SAKSHAM WEB CLIENT — PRODUCTION ENVIRONMENT TEMPLATE
# Copy to .env or set in your deployment pipeline (e.g. Vercel, Netlify, Docker)
# ═══════════════════════════════════════════════════════════════════════════════

# Primary Backend API Endpoint
# In production, specify your hosted API domain (e.g., https://api.saksham.gov.in/api/v1)
# When empty or omitted, falls back to local relative path /api/v1 (reverse proxy)
VITE_API_URL=/api/v1

# FastAPI / Decision Engine URL (if deployed on dedicated microservice)
VITE_FASTAPI_URL=

# Realtime WebSocket Telemetry Endpoint
# In production: wss://api.saksham.gov.in/api/v1/ws
VITE_WS_URL=

# Optional Map Tile Provider / Style URL
# Defaults to high-reliability Carto/OSM vector CDN tiles (no proprietary key required)
VITE_MAP_STYLE_URL=https://basemaps.cartocdn.com/gl/positron-gl-style/style.json

# Environment Mode
VITE_APP_ENV=production
