# ═══════════════════════════════════════════════════════════════════════════════
# SAKSHAM PLATFORM — ROOT ENVIRONMENT CONFIGURATION
# Disaster Relief Resource-Demand Matching & Logistics Coordination System
# ═══════════════════════════════════════════════════════════════════════════════

# ── 1. GLOBAL ENVIRONMENT ──
NODE_ENV=production
APP_ENV=production
TZ=Asia/Kolkata

# ── 2. DATABASE CONFIGURATION (PostgreSQL + Prisma) ──
# Format: postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?schema=public
DATABASE_URL="postgresql://saksham_admin:saksham_secure_pass_2026@localhost:5432/saksham_disaster_db?schema=public"

# ── 3. NODE.JS CORE API SERVICE (services/api) ──
PORT=4000
API_HOST=0.0.0.0
JWT_SECRET=saksham_super_secret_jwt_key_prod_2026_change_in_production
JWT_EXPIRES_IN=24h
CORS_ORIGIN=*

# ── 4. PYTHON OPTIMIZATION ENGINE (optimization / services/optimizer) ──
OPTIMIZER_PORT=8000
OPTIMIZER_HOST=0.0.0.0
ORTOOLS_MAX_SOLVE_TIME_SECONDS=30

# ── 5. FRONTEND WEB CLIENT (apps/web) ──
VITE_API_URL=http://localhost:4000/api
VITE_FASTAPI_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:4000/api/v1/ws
VITE_MAP_STYLE_URL=https://basemaps.cartocdn.com/gl/positron-gl-style/style.json
