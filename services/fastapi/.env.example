APP_NAME="SAKSHAM FastAPI Service"
APP_VERSION="0.1.0"
ENVIRONMENT="development"
API_PREFIX="/api/v1"
FRONTEND_ORIGIN="http://localhost:5173"
PORT=8000
HOST="0.0.0.0"

# OSRM road routing (used by matching, dispatch recommendations, and
# the /routing endpoints). Leave OSRM_ENABLED=false to use straight-line
# distance fallback (no external dependency needed for local dev).
# Set true once your local OSRM server (india-260819.osrm) is running.
OSRM_ENABLED=false
OSRM_LOCAL_URL="http://localhost:5000"
OSRM_PUBLIC_URL="https://router.project-osrm.org"
OSRM_PROFILE="driving"
OSRM_TIMEOUT_SECONDS=3.0
